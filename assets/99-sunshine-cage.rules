# Sunshine/libvirtualhid virtual input is put in its own seat, so the host
# desktop (seat0) ignores it and only the headless cage reads it.
# Companion: /usr/local/lib/libseat_seat_cage.so (LD_PRELOAD seat-name shim).
#
# WL_OUTPUT is the only way cage learns which output an absolute pointer
# belongs to. Without it cage logs "cannot be mapped to an output device" and
# the cursor never moves. HEADLESS-1 is the name wlroots gives the single
# headless output (WLR_HEADLESS_OUTPUTS=1).
ACTION=="add|change", SUBSYSTEM=="input", ATTRS{name}=="libvirtualhid*", ENV{ID_SEAT}="seat-cage", ENV{WL_OUTPUT}="HEADLESS-1"
